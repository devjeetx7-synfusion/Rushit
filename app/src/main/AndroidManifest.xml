<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Firebase Authentication and Supabase data access are both network calls. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requested only when a user explicitly chooses to attach their current location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        No authentication deep link, redirect URI or browser query is declared any more: Google
        sign-in completes in-process through Credential Manager and Firebase, and phone verification
        completes through a Firebase callback. RushIt never opens a browser to sign in, so it needs no
        <queries> entry for Custom Tabs and no rushit:// intent filter.

        Firebase's phone verification uses Google Play services' app verification (Play Integrity, with
        reCAPTCHA fallback). That needs no extra permission here: RushIt does not read SMS itself, so
        RECEIVE_SMS / READ_SMS are deliberately absent, and code auto-retrieval is a bonus rather than a
        requirement (manual entry always works).
    -->

    <application
        android:name=".RushItApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RushIt"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
